---
import Base from '../layouts/Base.astro';
import { socials, url } from '../lib/urls';
import { formEndpoint } from '../lib/contact.mjs';
const endpoint = formEndpoint(import.meta.env.PUBLIC_FORMSPREE_ID);
---
<Base title="Contact"><div class="wrap"><header class="page-heading"><p class="eyebrow accent">Let’s talk</p><h1>Get in touch</h1><p class="lead">I’m exploring AI-for-science opportunities for after my PhD, expected Spring 2027. I’m also happy to talk research, scientific software, and interesting collaborations.</p></header><div class="contact-layout"><div><h2>Research & collaborations</h2><p>Tell me a little about your team, the science you’re working on, or what brought you here.</p><div class="contact-socials"><a class="social-badge" href={socials.linkedin}><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.119 20.452H3.555V9h3.564v11.452z"/></svg>LinkedIn ↗</a><a class="social-badge" href={socials.github}>GitHub ↗</a></div></div><div class="contact-form">
  {!endpoint && <p class="notice">The contact form is not open yet. In the meantime, please <a href={socials.linkedin}>get in touch on LinkedIn ↗</a>.</p>}
  <form id="contact-form" action={endpoint ?? undefined} method="post" data-enabled={Boolean(endpoint)}>
    <fieldset disabled={!endpoint} style="border:0;padding:0;margin:0"><legend class="sr-only">Send Ethan a message</legend><div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="email">Your email</label><input id="email" type="email" name="email" autocomplete="email" required maxlength="254" /></div><div class="field"><label for="message">Message</label><textarea id="message" name="message" required minlength="10" maxlength="10000"></textarea></div><div class="honeypot" aria-hidden="true"><label for="company-website">Leave this field empty</label><input id="company-website" name="_gotcha" tabindex="-1" autocomplete="off" /></div><input type="hidden" name="subject" value="New message from Ethan Meitz’s website" /><button class="button" type="submit" disabled={!endpoint}>Send message <span aria-hidden="true">↗</span></button></fieldset><p class="form-note">Messages are processed by Formspree. <a href={url('privacy/')}>Privacy details</a>.</p><p class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1"></p><noscript>{endpoint ? 'Submitting will open Formspree’s confirmation page.' : 'Please use the LinkedIn link to get in touch.'}</noscript>
  </form></div></div></div></Base>
<script>
  import { sendContact } from '../lib/contact.mjs';
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type=submit]');
  if (form && status && button) form.addEventListener('submit', async event=>{
    event.preventDefault();
    if (form.dataset.enabled !== 'true' || !form.reportValidity() || button.disabled) return;
    const data = new FormData(form);
    if (data.get('_gotcha')) { status.textContent = 'Please leave the extra field empty and try again.'; return; }
    button.disabled = true;
    button.textContent = 'Sending…';
    status.textContent = 'Sending your message…';
    form.setAttribute('aria-busy','true');
    try {
      await sendContact(form.action, data);
      status.textContent = 'Your message was sent. Thanks for getting in touch!';
      form.reset();
    } catch (error) {
      status.textContent = error instanceof Error && error.message !== 'Failed to fetch' ? error.message : 'Delivery could not be confirmed. Please check your connection and try again, or use LinkedIn.';
    } finally {
      button.disabled = false;
      button.textContent = 'Send message ↗';
      form.removeAttribute('aria-busy');
      status.focus();
    }
  });
</script>
