---
import { getCollection } from 'astro:content';
import { url } from '../lib/urls';
import ScienceVisual from './ScienceVisual.astro';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<div class="project-grid">{projects.map((project, i) => <article class={`project-card ${project.data.color}`}>
  <a class="project-image" tabindex="-1" aria-hidden="true" href={url(`research/${project.id}/`)}><ScienceVisual kind={['solids','compute','proteins'][i]} /></a>
  <div class="project-card-body"><p class="eyebrow">0{i+1} / {project.data.category}</p><h3><a href={url(`research/${project.id}/`)}>{project.data.shortTitle}<span aria-hidden="true"> ↗</span></a></h3><p>{project.data.description}</p><div class="tags">{project.data.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div></div>
</article>)}</div>
