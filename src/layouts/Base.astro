---
import LinkArrow from '../components/LinkArrow.astro';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import sansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { url, socials } from '../lib/urls';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  theme?: string;
}
const {
  title,
  description = 'Ethan Meitz is a computational scientist and DOE CSGF fellow working across solid-state physics, high-performance computing, and machine learning for biology.',
  noindex = false,
  theme = '',
} = Astro.props;
const canonical = new URL(noindex ? url('404.html') : Astro.url.pathname, Astro.site);
const nav = [
  ['About', 'about/'],
  ['Research', 'research/'],
  ['Writing', 'writing/'],
  ['Art', 'art/'],
  ['Playground', 'fun/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f0" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg?v=cowboy')} type="image/svg+xml" />
    <meta property="og:title" content={`${title} · Ethan Meitz`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title === 'Home' ? 'Ethan Meitz · Computational scientist' : `${title} · Ethan Meitz`}</title>
  </head>
  <body class={theme}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href={url()} aria-label="Ethan Meitz home">
        ethan meitz<span aria-hidden="true">.</span>
      </a>
      <nav aria-label="Main navigation">
        {nav.map(([label, path]) => (
          <a
            data-prefetch-after-load
            href={url(path)}
            aria-current={Astro.url.pathname.startsWith(url(path)) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a
          data-prefetch-after-load
          class="nav-contact"
          href={url('contact/')}
          aria-current={Astro.url.pathname.startsWith(url('contact/')) ? 'page' : undefined}
        >
          Contact Me{' '}
          <span aria-hidden="true">
            <LinkArrow />
          </span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div>
        <a class="wordmark" href={url()}>
          ethan meitz<span aria-hidden="true">.</span>
        </a>
        <p>Computational scientist · Carnegie Mellon University</p>
      </div>
      <div class="footer-links">
        <a href={socials.github} target="_blank" rel="noopener noreferrer">
          GitHub <LinkArrow />
        </a>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn <LinkArrow />
        </a>
        <a href={url('contact/')}>Contact</a>
        <a href={url('archive/')}>Project archive</a>
        <a href={url('privacy/')}>Privacy</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} Ethan Meitz</p>
    </footer>
  </body>
</html>

<script>
  import { prefetch } from 'astro:prefetch';
  // Wait for the current page's initial resources before warming menu destinations.
  function warmNavigation() {
    const run = () => {
      document
        .querySelectorAll<HTMLAnchorElement>('a[data-prefetch-after-load]')
        .forEach((link) => {
          const rect = link.getBoundingClientRect();
          if (rect.bottom > 0 && rect.top < window.innerHeight) prefetch(link.href);
        });
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(run);
    else setTimeout(run, 250);
  }
  if (document.readyState === 'complete') warmNavigation();
  else window.addEventListener('load', warmNavigation, { once: true });
</script>
