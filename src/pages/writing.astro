---
import Base from '../layouts/Base.astro';
import { url } from '../lib/urls';
import { publications, talks } from '../data/publications';
---
<Base title="Writing & talks"><div class="wrap"><header class="page-heading"><p class="eyebrow accent">Publications & science communication</p><h1>Writing & talks</h1><p class="lead">Research papers, conference presentations, and science communication.</p></header><div class="article-layout"><aside class="article-sidebar"><a href="#communication">Science communication</a><a href="#publications">Publications</a><a href="#talks">Conference talks</a></aside><div>
  <section id="communication" class="writing-list"><h2 style="margin-bottom:25px">Science communication</h2><article><span class="status">Forthcoming · CSGF essay</span><h3>Atomic vibrations and materials modeling</h3><p>A science communication essay about atomic vibrations, the complexity hidden in simple models, and bringing decades-old physics to life with modern computing. Link to the published essay coming soon.</p><a class="text-link" href={url('writing/cyse/')}>2026 CYSE Honorable Mention ↗</a></article><article><span class="status">Forthcoming · CSGF podcast</span><h3>cuNumeric.jl and the CSGF experience</h3><p>Discussing cuNumeric.jl, our collaboration with NVIDIA, and what it is like to have an advisor who also held the DOE CSGF fellowship. Listening link coming soon.</p></article></section>
  <section id="publications" class="section"><h2 style="margin-bottom:25px">Publications</h2>{publications.map(p=><article class="publication"><span class="status">{p.status}</span><h3>{p.href ? <a href={p.href}>{p.title} ↗</a> : p.title}</h3><p>{p.authors}</p><p>{p.venue}</p></article>)}</section>
  <section id="talks"><h2 style="margin-bottom:25px">Selected talks</h2>{talks.map(t=><article class="publication"><p class="eyebrow accent">{t.venue} · {t.year}</p><h3>{t.title}</h3><p>{t.authors}</p></article>)}</section>
  </div></div></div></Base>
