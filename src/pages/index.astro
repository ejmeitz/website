---
import Base from '../layouts/Base.astro';
import Asset from '../components/Asset.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { url, socials } from '../lib/urls';
---
<Base title="Home">
  <section class="hero wrap">
    <div>
      <p class="eyebrow accent">Computational scientist · DOE CSGF fellow</p>
      <h1>Ethan Meitz</h1>
      <p class="hero-role">Computational scientist</p>
      <p class="intro">I’m a mechanical engineering PhD researcher at Carnegie Mellon. I use physics, machine learning, and high-performance computing to understand the world—from vibrating atoms to interacting proteins.</p>
      <div class="actions"><a class="button" href={url('research/')}>Explore my research <span aria-hidden="true">↗</span></a><a class="text-link" href={url('about/')}>A little about me</a></div>
    </div>
    <figure class="hero-art"><div class="art-panel"><span class="art-label">Watercolor</span><Asset name="elephant.png" alt="My watercolor elephant, painted in bright washes of blue, pink, and yellow" eager /></div><figcaption><span>Elephant · Watercolor</span><a href={url('art/')}>View my artwork ↗</a></figcaption></figure>
  </section>
  <div class="credentials wrap"><strong>Carnegie Mellon University</strong><span>Mechanical Engineering PhD</span><span class="divider"></span><span class="availability">Expected Spring 2027 · Exploring AI-for-science roles</span></div>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow accent">Selected work</p><h2>Research & software</h2></div><a class="text-link" href={url('research/')}>All research ↗</a></div><ProjectCards /></section>
  <section class="writing-band"><div class="section wrap writing-layout"><div><p class="eyebrow accent">Writing & talks</p><h2>Science communication</h2><div class="actions"><a class="text-link" href={url('writing/')}>Writing & talks ↗</a></div></div><div class="writing-list"><article><span class="status">Forthcoming · Essay</span><h3>Atomic vibrations and materials modeling</h3><p>How a little scientific archaeology and modern computing help us understand vibrating matter. A science communication essay for CSGF.</p></article><article><span class="status">Forthcoming · Podcast</span><h3>cuNumeric.jl and the CSGF experience</h3><p>A conversation about cuNumeric.jl, working with NVIDIA, and having an advisor who was a CSGF fellow too.</p></article></div></div></section>
  <section class="section wrap personal-teaser"><Asset name="AmeriCorps.jpg" alt="Ethan and his Habitat for Humanity AmeriCorps coworkers at the end of their summer of service" /><div><p class="eyebrow accent">Outside the lab</p><h2>AmeriCorps, art & drumming</h2><p>I grew up in St. Paul, Minnesota. Away from a computer, I’m happiest drawing, playing drums, or making something with my hands. Serving with AmeriCorps taught me how much I enjoy helping other people build things, too.</p><div class="actions"><a class="text-link" href={url('about/')}>More about me ↗</a></div></div></section>
  <section class="wrap section" style="border-top:1px solid var(--line);padding-top:35px"><div class="section-heading"><div><p class="eyebrow accent">What’s next</p><h2>Research opportunities</h2></div><a class="button" href={url('contact/')}>Get in touch ↗</a></div><p class="muted">I’m interested in AI-for-science research where ambitious questions meet serious computational resources.</p><div class="actions"><a class="text-link" href={socials.github}>GitHub ↗</a><a class="text-link" href={socials.linkedin}>LinkedIn ↗</a></div></section>
</Base>
