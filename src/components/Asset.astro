---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { name: string; alt: string; class?: string; eager?: boolean; widths?: number[] }
const { name, alt, class: className, eager = false, widths = [400, 800, 1400] } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*', { eager: true });
const asset = images[`../assets/${name}`]?.default;
if (!asset) throw new Error(`Missing image: ${name}`);
---
<Image src={asset} alt={alt} class={className} widths={widths.filter(w => w <= asset.width)} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 60vw, 800px" format="webp" loading={eager ? 'eager' : 'lazy'} decoding="async" />
