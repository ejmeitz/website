---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  widths?: number[];
  sizes?: string;
  quality?: number;
}
const {
  name,
  alt,
  class: className,
  eager = false,
  quality,
  widths = [400, 800, 1400],
  sizes = '(max-width: 700px) 92vw, (max-width: 1100px) 60vw, 800px',
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*', { eager: true });
const asset = images[`../assets/${name}`]?.default;
if (!asset) throw new Error(`Missing image: ${name}`);
---

<Image
  src={asset}
  alt={alt}
  class={className}
  widths={[
    ...new Set([
      ...widths.filter((w) => w <= asset.width),
      Math.min(asset.width, Math.max(...widths)),
    ]),
  ].sort((a, b) => a - b)}
  sizes={sizes}
  width={Math.min(asset.width, 1400)}
  format="webp"
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
