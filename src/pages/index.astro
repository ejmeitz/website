---
import Base from '../layouts/Base.astro';
import Asset from '../components/Asset.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { url, socials } from '../lib/urls';
---
<Base title="Home">
  <section class="hero wrap">
    <div>
      <p class="eyebrow accent">Computational scientist · DOE CSGF fellow</p>
      <h1>Ethan Meitz</h1>
      <p class="hero-role">Computational scientist</p>
      <p class="intro">I’m a mechanical engineering PhD researcher at Carnegie Mellon. I use physics, machine learning, and high-performance computing to understand the world—from vibrating atoms to interacting proteins.</p>
      <p class="intro">I’m exploring AI-for-science research roles, with a focus on scientific discovery through machine learning and high-performance computing.</p>
      <div class="actions"><a class="button" href={url('research/')}>Explore my research <span aria-hidden="true">↗</span></a><a class="button" href={url('about/')}>About Me <span aria-hidden="true">↗</span></a></div>
      <div class="actions hero-contact"><a class="text-link" href={socials.github}>GitHub ↗</a><a class="text-link" href={socials.linkedin}>LinkedIn ↗</a><a class="text-link" href={url('contact/')}>Get in touch ↗</a></div>
    </div>
    <figure class="hero-portrait"><Asset name="ethan-waterfront.jpeg" alt="Ethan Meitz by the water at sunset" eager /></figure>
  </section>
  <div class="credentials wrap"><strong>Carnegie Mellon University</strong><span>Mechanical Engineering PhD</span><span class="divider"></span><span class="availability">Expected Spring 2027 · Exploring AI-for-science roles</span></div>
  <section class="section wrap highlights" aria-labelledby="highlights-heading">
    <h2 id="highlights-heading">Highlights</h2>
    <section class="highlight-group" aria-labelledby="research-highlights">
      <div class="section-heading"><h3 id="research-highlights">Research & software</h3><a class="text-link" href={url('research/')}>All research ↗</a></div>
      <ProjectCards headingLevel="h4" />
    </section>
    <section class="highlight-group" aria-labelledby="writing-highlights">
      <div class="section-heading"><h3 id="writing-highlights">Writing</h3><a class="text-link" href={url('writing/')}>All writing ↗</a></div>
      <div class="highlight-cards">
        <article class="highlight-card essay-highlight">
          <a class="highlight-cover" href="https://deixismagazine.org/2026/09/good-vibrations/" aria-label="Read Good vibrations in DEIXIS"><Asset name="good-vibrations-cover.png" alt="Cubic boron arsenide with blue boron atoms and pink arsenic atoms" /></a>
          <div class="highlight-card-body"><span class="status">Essay · September 2026</span><h4><a href="https://deixismagazine.org/2026/09/good-vibrations/">Good vibrations ↗</a></h4><p>My essay on atomic motion and modeling solids, published in DEIXIS. Honorable Mention in the 2026 Communicate Your Science & Engineering (CYSE) contest.</p><p class="image-credit">Cover image: Ethan Meitz</p></div>
        </article>
        <article class="highlight-card"><a class="highlight-cover" href={url('research/cunumeric/#video')} aria-label="Watch our JuliaCon 2025 talk"><img src="https://i.ytimg.com/vi/rFJMqKIJuNc/hqdefault.jpg" alt="Video thumbnail for our cuNumeric.jl talk at JuliaCon 2025" width="480" height="360" loading="lazy" decoding="async" /></a><div class="highlight-card-body"><span class="status">Conference · Pittsburgh</span><h4><a href="https://www.youtube.com/watch?v=rFJMqKIJuNc">JuliaCon 2025 ↗</a></h4><p>David and I presented cuNumeric.jl at JuliaCon 2025 in Pittsburgh. I also served as a local liaison, helping coordinate spaces and reservations with CMU and Pitt.</p><a class="text-link" href={url('research/cunumeric/#video')}>Watch our talk ↗</a></div></article>
        <article class="highlight-card"><div class="highlight-card-body"><span class="status">Forthcoming · Podcast</span><h4>cuNumeric.jl and the CSGF experience</h4><p>A conversation about cuNumeric.jl, working with NVIDIA, and having an advisor who was a CSGF fellow too.</p></div></article>
      </div>
    </section>
  </section>
  <section class="section wrap personal-teaser"><div class="personal-images"><figure class="personal-art"><a href={url('art/')}><Asset name="elephant.png" alt="My watercolor elephant in blue, pink, and yellow" /></a><figcaption><a href={url('art/')}>Elephant · Watercolor ↗</a></figcaption></figure><figure><Asset name="americorps-upscaled.png" alt="Ethan and his Habitat for Humanity AmeriCorps coworkers at a construction site" /><figcaption>Habitat for Humanity · St. Paul, 2019</figcaption></figure></div><div><p class="eyebrow accent">Outside the lab</p><h2>Art, drumming & Habitat for Humanity</h2><p>I grew up in St. Paul, Minnesota. Outside research, I draw, paint, and play drums. I’ve also spent many hours building homes with Habitat for Humanity, including a summer of AmeriCorps service in 2019.</p><div class="actions"><a class="text-link" href={url('about/')}>More about me ↗</a></div></div></section>

</Base>
