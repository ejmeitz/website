---
import Base from '../layouts/Base.astro';
import Asset from '../components/Asset.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { url, socials } from '../lib/urls';
---
<Base title="Home">
  <section class="hero wrap">
    <div>
      <p class="eyebrow accent">Computational scientist · DOE CSGF fellow</p>
      <h1>Ethan Meitz</h1>
      <p class="hero-role">Computational scientist</p>
      <p class="intro">I’m a mechanical engineering PhD researcher at Carnegie Mellon. I use physics, machine learning, and high-performance computing to understand the world—from vibrating atoms to interacting proteins.</p>
      <div class="actions"><a class="button" href={url('research/')}>Explore my research <span aria-hidden="true">↗</span></a><a class="text-link" href={url('about/')}>A little about me</a></div>
    </div>
    <figure class="hero-portrait"><Asset name="ethan-waterfront.jpeg" alt="Ethan Meitz by the water at sunset" eager /></figure>
  </section>
  <div class="credentials wrap"><strong>Carnegie Mellon University</strong><span>Mechanical Engineering PhD</span><span class="divider"></span><span class="availability">Expected Spring 2027 · Exploring AI-for-science roles</span></div>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow accent">Selected work</p><h2>Research & software</h2></div><a class="text-link" href={url('research/')}>All research ↗</a></div><ProjectCards /></section>
  <section class="writing-band"><div class="section wrap writing-layout"><div><p class="eyebrow accent">Writing & talks</p><h2>Highlights</h2><div class="actions"><a class="text-link" href={url('writing/')}>Writing & talks ↗</a></div></div><div class="writing-list"><article class="essay-highlight"><a class="highlight-cover" href="https://deixismagazine.org/2026/09/good-vibrations/" aria-label="Read Good vibrations in DEIXIS"><Asset name="good-vibrations-cover.png" alt="Cubic boron arsenide with blue boron atoms and pink arsenic atoms" /></a><span class="status">Published · DEIXIS · September 2026</span><h3><a href="https://deixismagazine.org/2026/09/good-vibrations/">Good vibrations ↗</a></h3><p>My essay on atomic motion, heat, and modeling solids received a 2026 Communicate Your Science & Engineering (CYSE) Honorable Mention.</p><a class="text-link" href="https://deixismagazine.org/2026/09/good-vibrations/">Read the essay ↗</a><p class="image-credit">Cover image: Ethan Meitz</p></article><article><span class="status">Forthcoming · Podcast</span><h3>cuNumeric.jl and the CSGF experience</h3><p>A conversation about cuNumeric.jl, working with NVIDIA, and having an advisor who was a CSGF fellow too.</p></article></div></div></section>
  <section class="section wrap personal-teaser"><div class="personal-images"><figure><Asset name="americorps-upscaled.png" alt="Ethan and his Habitat for Humanity AmeriCorps coworkers at a construction site" /><figcaption>AmeriCorps · St. Paul, 2019</figcaption></figure><figure class="personal-art"><a href={url('art/')}><Asset name="elephant.png" alt="My watercolor elephant in blue, pink, and yellow" /></a><figcaption><a href={url('art/')}>Elephant · Watercolor ↗</a></figcaption></figure></div><div><p class="eyebrow accent">Outside the lab</p><h2>AmeriCorps, art & drumming</h2><p>I grew up in St. Paul, Minnesota. Away from a computer, I’m happiest drawing, playing drums, or making something with my hands. Serving with AmeriCorps taught me how much I enjoy helping other people build things, too.</p><div class="actions"><a class="text-link" href={url('about/')}>More about me ↗</a></div></div></section>
  <section class="wrap section" style="border-top:1px solid var(--line);padding-top:35px"><div class="section-heading"><div><p class="eyebrow accent">What’s next</p><h2>Research opportunities</h2></div><a class="button" href={url('contact/')}>Get in touch ↗</a></div><p class="muted">I’m interested in AI-for-science research where ambitious questions meet serious computational resources.</p><div class="actions"><a class="text-link" href={socials.github}>GitHub ↗</a><a class="text-link" href={socials.linkedin}>LinkedIn ↗</a></div></section>
</Base>
