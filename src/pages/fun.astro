---
import Base from '../layouts/Base.astro';
const sketches = [{title:'Bouncing balls',id:'Ggf2mFF9o',description:'A small experiment in motion, collisions, and watching what happens next.'},{title:'Tic-tac-toe with minimax',id:'6Ll3mkIKB',description:'An old favorite, with a computer opponent that thinks through its next move.'}];
---
<Base title="Playground"><div class="wrap"><header class="page-heading"><p class="eyebrow accent">Animations & games</p><h1>Playground</h1><p class="lead">A couple of coding experiments from the original website, built with p5.js.</p></header><div class="play-grid">{sketches.map((s,i)=><article class="play-card"><p class="eyebrow">Experiment 0{i+1} · p5.js</p><h2>{s.title}</h2><p>{s.description}</p><div class="embed-holder" data-src={`https://editor.p5js.org/ejmeitz/embed/${s.id}`} data-title={s.title}><button type="button">{i === 0 ? 'Start animation' : 'Play tic-tac-toe'} ↗</button></div><small>Loads an external p5.js sketch when started. {i === 1 && 'This older sketch may not work on iOS.'} <a href={`https://editor.p5js.org/ejmeitz/full/${s.id}`} target="_blank" rel="noopener noreferrer">Open separately ↗</a></small></article>)}</div></div></Base>
<script>
  document.querySelectorAll<HTMLElement>('.embed-holder').forEach(holder=>{
    holder.querySelector('button')?.addEventListener('click',()=>{
      const frame = document.createElement('iframe');
      frame.src = holder.dataset.src!;
      frame.title = holder.dataset.title!;
      frame.setAttribute('sandbox','allow-scripts allow-same-origin');
      frame.setAttribute('referrerpolicy','strict-origin-when-cross-origin');
      frame.setAttribute('allow','fullscreen');
      holder.replaceChildren(frame);
      frame.focus();
    });
  });
</script>
