---
import LinkArrow from '../components/LinkArrow.astro';
import Base from '../layouts/Base.astro';
import Asset from '../components/Asset.astro';
import { publications, talks } from '../data/publications';
---

<Base title="Writing">
  <div class="wrap">
    <header class="page-heading">
      <p class="eyebrow accent">Publications & science communication</p>
      <h1>Writing</h1>
      <p class="lead">Research papers, conference presentations, and science communication.</p>
    </header>
    <div class="article-layout">
      <aside class="article-sidebar">
        <a href="#communication">Science communication</a>
        <a href="#publications">Publications</a>
        <a href="#talks">Conference talks</a>
      </aside>
      <div>
        <section id="communication" class="writing-list">
          <h2 style="margin-bottom:25px">Science communication</h2>
          <article class="essay-entry">
            <a
              class="essay-thumb"
              href="https://deixismagazine.org/2026/09/good-vibrations/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Read Good vibrations"
            >
              <Asset
                name="good-vibrations-cover.png"
                alt="Blue and pink atoms in cubic boron arsenide"
                widths={[400]}
              />
            </a>
            <div>
              <span class="status">Published · DEIXIS · September 2026</span>
              <h3>
                <a
                  href="https://deixismagazine.org/2026/09/good-vibrations/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Good vibrations <LinkArrow />
                </a>
              </h3>
              <p>
                My essay on atomic vibrations and the physics behind materials modeling. Awarded an
                Honorable Mention in the 2026 DOE CSGF Communicate Your Science & Engineering (CYSE)
                contest.
              </p>
              <a
                class="text-link"
                href="https://deixismagazine.org/2026/09/good-vibrations/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the published essay <LinkArrow />
              </a>
            </div>
          </article>
          <article>
            <span class="status">Forthcoming · CSGF podcast</span>
            <h3>cuNumeric.jl and the CSGF experience</h3>
            <p>
              Discussing cuNumeric.jl, our collaboration with NVIDIA, and what it is like to have an
              advisor who also held the DOE CSGF fellowship. Listening link coming soon.
            </p>
          </article>
        </section>
        <section id="publications" class="section">
          <h2 style="margin-bottom:25px">Publications</h2>
          {publications.map((p) => (
            <article class="publication">
              <span class="status">{p.status}</span>
              <h3>
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener noreferrer">
                    {p.title} <LinkArrow />
                  </a>
                ) : (
                  p.title
                )}
              </h3>
              <p>{p.authors}</p>
              <p>{p.venue}</p>
            </article>
          ))}
        </section>
        <section id="talks">
          <h2 style="margin-bottom:25px">Selected talks</h2>
          <p>
            <a
              href="https://www.youtube.com/watch?v=rFJMqKIJuNc"
              target="_blank"
              rel="noopener noreferrer"
            >
              Watch our JuliaCon 2025 talk <LinkArrow />
            </a>
          </p>
          {talks.map((t) => (
            <article class="publication">
              <p class="eyebrow accent">
                {t.venue} · {t.year}
              </p>
              <h3>{t.title}</h3>
              <p>{t.authors}</p>
            </article>
          ))}
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .essay-entry {
    display: grid;
    grid-template-columns: clamp(130px, 20vw, 180px) minmax(0, 1fr);
    gap: 26px;
    align-items: stretch;
  }
  .essay-thumb {
    display: block;
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-radius: 5px;
  }
  .essay-thumb :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% center;
  }
  @media (max-width: 500px) {
    .essay-entry {
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 16px;
    }
    .essay-thumb {
      min-height: 0;
    }
  }
</style>
